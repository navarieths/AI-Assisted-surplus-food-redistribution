# Server configuration — copy to server/.env

PORT=4000
JWT_SECRET=change-me-in-production

# Map provider: osm | mapbox | google  (default osm, no key required)
MAP_PROVIDER=osm
# MAPBOX_TOKEN=pk.xxxx
# GOOGLE_MAPS_KEY=xxxx

# Optional: an LLM may ONLY rewrite match explanation text, never the score.
# Everything works with no key.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Geo tuning
# MATCH_RADIUS_KM=30
# GEO_TIMEOUT_MS=4000

# Matching: topN candidates routed, results returned, offers created, and weights.
# MATCH_TOP_N=10
# MATCH_RESULT_LIMIT=5
# MATCH_OFFER_LIMIT=5
# MATCH_WEIGHTS={"foodCompatibility":25,"demand":25,"quantityFit":15,"roadDistance":20,"timeFeasibility":15}

# Volunteer assignment: invitation timeout, batch size, travel cap and weights.
# VOLUNTEER_OFFER_TIMEOUT_SEC=600
# VOLUNTEER_OFFER_LIMIT=3
# VOLUNTEER_MAX_TRAVEL_MIN=60
# VOLUNTEER_WEIGHTS={"travelTime":50,"availability":30,"feasibility":20}

# Pickup OTP policy: codes are stored hashed and attempts are capped.
# OTP_MAX_ATTEMPTS=5
# OTP_HASH_ROUNDS=8

# Dev-only: move the volunteer marker along the route from a laptop.
# Set to false to disable POST /assignments/:id/simulate-location.
# ALLOW_SIMULATION=true
