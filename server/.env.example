# Server configuration — copy to server/.env

PORT=4000
JWT_SECRET=change-me-in-production

# Map provider: osm | mapbox | google  (default osm, no key required)
MAP_PROVIDER=osm
# MAPBOX_TOKEN=pk.xxxx
# GOOGLE_MAPS_KEY=xxxx

# Optional: an LLM may ONLY rewrite match explanation text, never the score.
# Everything works with no key.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Geo tuning
# MATCH_RADIUS_KM=30
# GEO_TIMEOUT_MS=4000
